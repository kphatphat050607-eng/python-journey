"""Exercise 03: tuple, packing and unpacking."""

coordinate = (3, 7)

# Unpacking
x, y = coordinate

# Packing
profile = ("Phát", 18, "Python")

# Unpacking
name, age, topic = profile

# Swap bằng unpacking
left = "A"
right = "B"

left, right = right, left

print(x, y)
print(name, age, topic)
print(left, right)







